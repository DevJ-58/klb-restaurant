{
  "name": "klb-vitrine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run optimize:images && tsc -b && vite build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "test:hero-layout": "node scripts/hero-layout-audit.mjs",
    "preview": "vite preview",
    "audit": "node scripts/audit-scroll.mjs",
